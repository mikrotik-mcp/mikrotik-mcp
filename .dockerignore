# Deny by default: do not upload local router configs, credentials, databases,
# screenshots, Git history, agent state or host node_modules to the builder.
**
!Dockerfile
!docker/
!docker/devices.example.json
!.dockerignore
!package.json
!bun.lock
!bunfig.toml
!bunup.config.ts
!tsconfig.json
!LICENSE
!src/
!src/**
!ui/
!ui/**
!scripts/
!scripts/**
!prompts/
!prompts/**
!schemas/
!schemas/**
!policies/
!policies/**
!assets/
!assets/flags/
!assets/flags/**
# Exclude generated/local files even inside the allow-listed source folders.
**/node_modules
**/dist
**/.env
**/.env.*
**/*.log
**/*.db
**/*.db-*
**/.DS_Store
