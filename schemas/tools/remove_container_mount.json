{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "remove_container_mount",
  "type": "object",
  "properties": {
    "id": {
      "description": "Stable .id from fresh discovery; never a row number",
      "type": "string",
      "pattern": "^\\*[\\da-fA-F]+$"
    },
    "list": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "src": {
      "type": "string",
      "minLength": 1
    },
    "dst": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
