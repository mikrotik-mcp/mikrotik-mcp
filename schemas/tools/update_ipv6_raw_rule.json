{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "update_ipv6_raw_rule",
  "type": "object",
  "properties": {
    "unset": {
      "description": "Properties to UNSET (RouterOS `!prop`), so they no longer apply — e.g. ['dst-address'] removes the destination-address match. snake_case or kebab-case. Not for setting a value.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "rule_id": {
      "type": "string"
    },
    "chain": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "src_address": {
      "type": "string"
    },
    "dst_address": {
      "type": "string"
    },
    "src_port": {
      "type": "string"
    },
    "dst_port": {
      "type": "string"
    },
    "port": {
      "type": "string"
    },
    "protocol": {
      "type": "string"
    },
    "in_interface": {
      "type": "string"
    },
    "out_interface": {
      "type": "string"
    },
    "in_interface_list": {
      "type": "string"
    },
    "out_interface_list": {
      "type": "string"
    },
    "src_address_list": {
      "type": "string"
    },
    "dst_address_list": {
      "type": "string"
    },
    "src_address_type": {
      "type": "string"
    },
    "dst_address_type": {
      "type": "string"
    },
    "src_mac_address": {
      "type": "string"
    },
    "hop_limit": {
      "type": "string"
    },
    "tcp_flags": {
      "type": "string"
    },
    "tcp_mss": {
      "type": "string"
    },
    "packet_size": {
      "type": "string"
    },
    "dscp": {
      "type": "string"
    },
    "ipsec_policy": {
      "type": "string"
    },
    "limit": {
      "type": "string"
    },
    "comment": {
      "type": "string"
    },
    "disabled": {
      "type": "boolean"
    },
    "log": {
      "type": "boolean"
    },
    "log_prefix": {
      "type": "string"
    }
  },
  "required": ["rule_id"],
  "additionalProperties": false
}
