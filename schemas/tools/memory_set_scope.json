{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "memory_set_scope",
  "type": "object",
  "properties": {
    "entityName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "scope": {
      "type": "string",
      "enum": ["device", "group", "shared"]
    },
    "members": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "confirmSharing": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": ["entityName", "scope", "members", "expectedRevision", "confirmSharing"],
  "additionalProperties": false
}
