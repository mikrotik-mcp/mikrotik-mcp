{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "test_dns_query",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "DNS name to resolve, e.g. example.com"
    },
    "server": {
      "description": "Optional DNS server IP address",
      "type": "string",
      "minLength": 1
    },
    "type": {
      "default": "A",
      "type": "string",
      "enum": ["A", "AAAA", "ANY", "ANY6"]
    }
  },
  "required": ["name", "type"],
  "additionalProperties": false
}
