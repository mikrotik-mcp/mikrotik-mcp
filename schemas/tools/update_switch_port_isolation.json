{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "update_switch_port_isolation",
  "type": "object",
  "properties": {
    "unset": {
      "description": "Properties to UNSET (RouterOS `!prop`), so they no longer apply — e.g. ['dst-address'] removes the destination-address match. snake_case or kebab-case. Not for setting a value.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "isolation_id": {
      "type": "string",
      "description": "Source port name or RouterOS '.id'"
    },
    "forwarding_override_ports": {
      "description": "Comma-separated allowed destination ports",
      "type": "string"
    },
    "comment": {
      "type": "string"
    }
  },
  "required": ["isolation_id"],
  "additionalProperties": false
}
