{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "update_igmp_proxy_interface",
  "type": "object",
  "properties": {
    "unset": {
      "description": "Properties to UNSET (RouterOS `!prop`), so they no longer apply — e.g. ['dst-address'] removes the destination-address match. snake_case or kebab-case. Not for setting a value.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "interface": {
      "type": "string",
      "description": "Existing IGMP-proxy interface name"
    },
    "upstream": {
      "type": "boolean"
    },
    "alternative_subnets": {
      "type": "string"
    },
    "threshold": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "comment": {
      "type": "string"
    },
    "disabled": {
      "type": "boolean"
    }
  },
  "required": ["interface"],
  "additionalProperties": false
}
