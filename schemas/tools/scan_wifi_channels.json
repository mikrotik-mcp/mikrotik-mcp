{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scan_wifi_channels",
  "type": "object",
  "properties": {
    "interface": {
      "type": "string",
      "minLength": 1
    },
    "duration": {
      "default": 5,
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "confirm": {
      "default": false,
      "description": "Explicit user approval to temporarily disconnect Wi-Fi clients.",
      "type": "boolean"
    }
  },
  "required": ["interface", "duration", "confirm"],
  "additionalProperties": false
}
