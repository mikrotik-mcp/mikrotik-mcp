{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "save_config_template",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,40}$",
      "description": "Template name"
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200000,
      "description": "RouterOS script text with {{variable}} places"
    }
  },
  "required": ["name", "content"],
  "additionalProperties": false
}
