{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "update_routing_filter_rule",
  "type": "object",
  "properties": {
    "unset": {
      "description": "Properties to UNSET (RouterOS `!prop`), so they no longer apply — e.g. ['dst-address'] removes the destination-address match. snake_case or kebab-case. Not for setting a value.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "rule_id": {
      "type": "string",
      "description": "Rule id, e.g. \"*3\""
    },
    "chain": {
      "type": "string"
    },
    "rule": {
      "type": "string"
    },
    "comment": {
      "type": "string"
    },
    "disabled": {
      "type": "boolean"
    }
  },
  "required": ["rule_id"],
  "additionalProperties": false
}
