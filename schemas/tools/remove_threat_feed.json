{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "remove_threat_feed",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][\\w.-]{0,40}$",
      "description": "The feed id used when subscribing"
    }
  },
  "required": ["name"],
  "additionalProperties": false
}
