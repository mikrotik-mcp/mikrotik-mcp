{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "update_wireguard_interface",
  "type": "object",
  "properties": {
    "unset": {
      "description": "Properties to UNSET (RouterOS `!prop`), so they no longer apply — e.g. ['dst-address'] removes the destination-address match. snake_case or kebab-case. Not for setting a value.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "name": {
      "type": "string"
    },
    "new_name": {
      "description": "Rename the interface to this (no spaces).",
      "type": "string",
      "pattern": "^\\S+$"
    },
    "listen_port": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "private_key": {
      "type": "string"
    },
    "mtu": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "comment": {
      "type": "string"
    },
    "disabled": {
      "type": "boolean"
    }
  },
  "required": ["name"],
  "additionalProperties": false
}
