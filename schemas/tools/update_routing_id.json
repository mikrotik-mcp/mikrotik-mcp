{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "update_routing_id",
  "type": "object",
  "properties": {
    "unset": {
      "description": "Properties to UNSET (RouterOS `!prop`), so they no longer apply — e.g. ['dst-address'] removes the destination-address match. snake_case or kebab-case. Not for setting a value.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "name": {
      "type": "string",
      "description": "Existing Router-ID instance name"
    },
    "id": {
      "description": "IPv4 router-id, or \"\" to clear",
      "type": "string"
    },
    "select_dynamic_id": {
      "description": "Interface/loopback name, or \"\" to clear",
      "type": "string"
    },
    "comment": {
      "type": "string"
    },
    "disabled": {
      "type": "boolean"
    }
  },
  "required": ["name"],
  "additionalProperties": false
}
