{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "apply_router_migration",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "mode": {
      "default": "rehearse",
      "type": "string",
      "enum": ["rehearse", "stage"]
    },
    "confirm": {
      "default": false,
      "type": "boolean"
    },
    "acknowledgeManual": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": ["id", "mode", "confirm", "acknowledgeManual"],
  "additionalProperties": false
}
