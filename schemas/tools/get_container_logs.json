{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "get_container_logs",
  "type": "object",
  "properties": {
    "contains": {
      "description": "Keep only lines with this text",
      "type": "string",
      "maxLength": 80
    },
    "lines": {
      "default": 50,
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    }
  },
  "required": ["lines"],
  "additionalProperties": false
}
