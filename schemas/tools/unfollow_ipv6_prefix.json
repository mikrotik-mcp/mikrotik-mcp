{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "unfollow_ipv6_prefix",
  "type": "object",
  "properties": {
    "interface": {
      "type": "string",
      "description": "Interface of the DHCPv6 client"
    },
    "list": {
      "default": "isp-prefix",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,30}$"
    }
  },
  "required": ["interface", "list"],
  "additionalProperties": false
}
