{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "update_rip_instance",
  "type": "object",
  "properties": {
    "unset": {
      "description": "Properties to UNSET (RouterOS `!prop`), so they no longer apply — e.g. ['dst-address'] removes the destination-address match. snake_case or kebab-case. Not for setting a value.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "name": {
      "type": "string",
      "description": "Existing RIP instance name"
    },
    "router_id": {
      "type": "string"
    },
    "routing_table": {
      "description": "Routing table to install routes into",
      "type": "string"
    },
    "redistribute": {
      "type": "string"
    },
    "in_filter_chain": {
      "type": "string"
    },
    "out_filter_chain": {
      "type": "string"
    },
    "originate_default": {
      "type": "string"
    },
    "comment": {
      "type": "string"
    },
    "disabled": {
      "type": "boolean"
    }
  },
  "required": ["name"],
  "additionalProperties": false
}
