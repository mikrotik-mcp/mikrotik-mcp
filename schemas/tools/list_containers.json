{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "list_containers",
  "type": "object",
  "properties": {
    "name_filter": {
      "description": "RouterOS name regex, escaped as a command value",
      "type": "string"
    },
    "tag_filter": {
      "type": "string"
    },
    "status_filter": {
      "description": "Legacy status regex; newer releases may expose flags instead",
      "type": "string"
    },
    "detail": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": ["detail"],
  "additionalProperties": false
}
