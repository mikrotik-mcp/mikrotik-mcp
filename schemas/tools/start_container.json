{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "start_container",
  "type": "object",
  "properties": {
    "id": {
      "description": "Stable .id from fresh discovery; never a row number",
      "type": "string",
      "pattern": "^\\*[\\da-fA-F]+$"
    },
    "name": {
      "description": "Exact unique container name",
      "type": "string",
      "minLength": 1
    },
    "tag": {
      "description": "Exact unique image tag, not a regex; prefer id when images are shared",
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
