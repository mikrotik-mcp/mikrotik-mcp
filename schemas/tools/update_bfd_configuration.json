{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "update_bfd_configuration",
  "type": "object",
  "properties": {
    "unset": {
      "description": "Properties to UNSET (RouterOS `!prop`), so they no longer apply — e.g. ['dst-address'] removes the destination-address match. snake_case or kebab-case. Not for setting a value.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "config_id": {
      "type": "string",
      "description": "Configuration id, e.g. \"*1\""
    },
    "interfaces": {
      "type": "string"
    },
    "vrf": {
      "type": "string"
    },
    "min_rx": {
      "type": "string"
    },
    "min_tx": {
      "type": "string"
    },
    "multiplier": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "forbid_bfd": {
      "type": "boolean"
    },
    "comment": {
      "type": "string"
    },
    "disabled": {
      "type": "boolean"
    }
  },
  "required": ["config_id"],
  "additionalProperties": false
}
