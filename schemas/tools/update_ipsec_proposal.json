{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "update_ipsec_proposal",
  "type": "object",
  "properties": {
    "unset": {
      "description": "Properties to UNSET (RouterOS `!prop`), so they no longer apply — e.g. ['dst-address'] removes the destination-address match. snake_case or kebab-case. Not for setting a value.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "name": {
      "type": "string",
      "description": "Current name of the IPsec proposal to update"
    },
    "new_name": {
      "type": "string"
    },
    "auth_algorithms": {
      "type": "string"
    },
    "enc_algorithms": {
      "type": "string"
    },
    "pfs_group": {
      "type": "string"
    },
    "lifetime": {
      "type": "string"
    },
    "disabled": {
      "type": "boolean"
    }
  },
  "required": ["name"],
  "additionalProperties": false
}
