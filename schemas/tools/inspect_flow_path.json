{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inspect_flow_path",
  "type": "object",
  "properties": {
    "client": {
      "type": "string",
      "format": "ipv4",
      "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$"
    },
    "destination": {
      "type": "string",
      "format": "ipv4",
      "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$"
    },
    "source_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "destination_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "protocol": {
      "type": "string",
      "enum": ["tcp", "udp"]
    },
    "interface_names": {
      "default": [],
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    }
  },
  "required": [
    "client",
    "destination",
    "source_port",
    "destination_port",
    "protocol",
    "interface_names"
  ],
  "additionalProperties": false
}
