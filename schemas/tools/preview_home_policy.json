{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "preview_home_policy",
  "type": "object",
  "properties": {
    "mac": {
      "type": "string",
      "pattern": "^(?:[\\da-f]{2}:){5}[\\da-f]{2}$"
    },
    "action": {
      "type": "string",
      "enum": ["pause", "priority", "route"]
    },
    "minutes": {
      "default": 30,
      "type": "integer",
      "minimum": 5,
      "maximum": 120
    },
    "startInMinutes": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 1440
    },
    "table": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "required": ["mac", "action", "minutes", "startInMinutes"],
  "additionalProperties": false
}
