{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "update_dot1x_server",
  "type": "object",
  "properties": {
    "unset": {
      "description": "Properties to UNSET (RouterOS `!prop`), so they no longer apply — e.g. ['dst-address'] removes the destination-address match. snake_case or kebab-case. Not for setting a value.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "server_id": {
      "type": "string",
      "description": "Interface name or RouterOS '.id'"
    },
    "auth_types": {
      "type": "string",
      "enum": ["dot1x", "mac-auth", "dot1x,mac-auth"]
    },
    "accounting": {
      "type": "boolean"
    },
    "interim_update": {
      "type": "string"
    },
    "mac_auth_mode": {
      "type": "string",
      "enum": ["mac-as-username", "mac-as-username-and-password"]
    },
    "guest_vlan_id": {
      "type": "string"
    },
    "reject_vlan_id": {
      "type": "string"
    },
    "server_fail_vlan_id": {
      "type": "string"
    },
    "reauth_timeout": {
      "type": "string"
    },
    "reauth_period": {
      "description": "RouterOS 7.25+ re-authentication period",
      "type": "string"
    },
    "comment": {
      "type": "string"
    },
    "disabled": {
      "type": "boolean"
    }
  },
  "required": ["server_id"],
  "additionalProperties": false
}
