{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "update_ipsec_peer",
  "type": "object",
  "properties": {
    "unset": {
      "description": "Properties to UNSET (RouterOS `!prop`), so they no longer apply — e.g. ['dst-address'] removes the destination-address match. snake_case or kebab-case. Not for setting a value.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "name": {
      "type": "string",
      "description": "Current name of the IPsec peer to update"
    },
    "new_name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "exchange_mode": {
      "type": "string",
      "enum": ["main", "aggressive", "ike2"]
    },
    "local_address": {
      "type": "string"
    },
    "port": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "passive": {
      "type": "boolean"
    },
    "comment": {
      "type": "string"
    },
    "disabled": {
      "type": "boolean"
    }
  },
  "required": ["name"],
  "additionalProperties": false
}
