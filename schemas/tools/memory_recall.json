{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "memory_recall",
  "type": "object",
  "properties": {
    "query": {
      "default": "",
      "type": "string",
      "maxLength": 500
    },
    "entityName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "limit": {
      "default": 12,
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "maxChars": {
      "default": 6000,
      "type": "integer",
      "minimum": 500,
      "maximum": 16000
    },
    "includeRelated": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": ["query", "limit", "maxChars", "includeRelated"],
  "additionalProperties": false
}
