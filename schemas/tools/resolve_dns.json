{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "resolve_dns",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "DNS name to resolve, e.g. 'example.com'"
    },
    "server": {
      "description": "Specific DNS server IP to query; defaults to the system resolver",
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["name"],
  "additionalProperties": false
}
