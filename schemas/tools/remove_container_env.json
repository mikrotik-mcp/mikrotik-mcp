{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "remove_container_env",
  "type": "object",
  "properties": {
    "id": {
      "description": "Stable .id from fresh discovery; never a row number",
      "type": "string",
      "pattern": "^\\*[\\da-fA-F]+$"
    },
    "list": {
      "type": "string",
      "minLength": 1
    },
    "key": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
