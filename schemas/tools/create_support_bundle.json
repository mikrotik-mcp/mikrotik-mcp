{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "create_support_bundle",
  "type": "object",
  "properties": {
    "since": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "until": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "cases": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "includeEvents": {
      "default": true,
      "type": "boolean"
    },
    "includeSnapshots": {
      "default": true,
      "type": "boolean"
    },
    "includeChecks": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": ["since", "until", "cases", "includeEvents", "includeSnapshots", "includeChecks"],
  "additionalProperties": false
}
