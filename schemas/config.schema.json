{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MikrotikConfig",
  "type": "object",
  "properties": {
    "serviceProbes": {
      "default": {
        "scheduled": {},
        "targets": {},
        "timeoutMs": 5000
      },
      "type": "object",
      "properties": {
        "scheduled": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "targets": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z\\d_-]{1,64}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["dns", "tcp", "tls", "https"]
              },
              "host": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[a-z\\d](?:[a-z\\d.-]*[a-z\\d])?$"
              },
              "port": {
                "default": 443,
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "path": {
                "default": "/health",
                "type": "string",
                "maxLength": 1024
              },
              "addresses": {
                "minItems": 1,
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["kind", "host", "port", "path", "addresses"],
            "additionalProperties": false
          }
        },
        "timeoutMs": {
          "default": 5000,
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        }
      },
      "required": ["scheduled", "targets", "timeoutMs"],
      "additionalProperties": false
    },
    "devices": {
      "default": {
        "default": {
          "host": "127.0.0.1",
          "username": "admin",
          "password": "",
          "port": 22,
          "timeoutMs": 10000,
          "tags": []
        }
      },
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "host": {
            "default": "127.0.0.1",
            "type": "string"
          },
          "fallbackHosts": {
            "maxItems": 7,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "ipv4",
                  "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$"
                },
                {
                  "type": "string",
                  "format": "ipv6",
                  "pattern": "^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))$"
                }
              ]
            }
          },
          "username": {
            "default": "admin",
            "type": "string"
          },
          "password": {
            "default": "",
            "type": "string"
          },
          "bandwidthAuth": {
            "type": "object",
            "properties": {
              "username": {
                "type": "string",
                "minLength": 1
              },
              "password": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              }
            },
            "required": ["username", "password"],
            "additionalProperties": false
          },
          "port": {
            "default": 22,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "keyFilename": {
            "type": "string"
          },
          "privateKey": {
            "type": "string"
          },
          "keyPassphrase": {
            "type": "string"
          },
          "passwordFrom": {
            "type": "string",
            "pattern": "^(?:env:[A-Za-z_][A-Za-z0-9_]*|file:.+|keyring:[A-Za-z0-9][A-Za-z0-9._@-]{0,63}\\/[A-Za-z0-9][A-Za-z0-9._@-]{0,63})$"
          },
          "keyPassphraseFrom": {
            "type": "string",
            "pattern": "^(?:env:[A-Za-z_][A-Za-z0-9_]*|file:.+|keyring:[A-Za-z0-9][A-Za-z0-9._@-]{0,63}\\/[A-Za-z0-9][A-Za-z0-9._@-]{0,63})$"
          },
          "sshAgent": {
            "type": "boolean"
          },
          "hostKeySha256": {
            "type": "string",
            "pattern": "^(?:SHA256:)?[A-Za-z0-9+/]{43}=?$"
          },
          "timeoutMs": {
            "default": 10000,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "jumpVia": {
            "type": "string"
          },
          "jumpHost": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string"
              },
              "port": {
                "default": 22,
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "username": {
                "default": "admin",
                "type": "string"
              },
              "password": {
                "type": "string"
              },
              "keyFilename": {
                "type": "string"
              },
              "privateKey": {
                "type": "string"
              },
              "keyPassphrase": {
                "type": "string"
              },
              "timeoutMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["host", "port", "username"],
            "additionalProperties": false
          },
          "mac": {
            "type": "string"
          },
          "sourceMac": {
            "type": "string"
          },
          "macHost": {
            "type": "string"
          },
          "macPort": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "api": {
            "type": "boolean"
          },
          "apiPort": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "apiInsecureTls": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "disabled": {
            "type": "boolean"
          }
        },
        "required": ["host", "username", "password", "port", "timeoutMs", "tags"],
        "additionalProperties": false
      }
    },
    "defaultDevice": {
      "default": "default",
      "type": "string"
    },
    "mcp": {
      "default": {
        "transport": "stdio",
        "host": "0.0.0.0",
        "port": 8000,
        "allowedHosts": "",
        "allowedOrigins": "",
        "corsOrigins": "",
        "sessionIdleTimeout": 86400000,
        "toolPageSize": 0,
        "toolSurface": "full",
        "coreTools": "",
        "appViews": false,
        "capabilityGating": "annotate"
      },
      "type": "object",
      "properties": {
        "transport": {
          "default": "stdio",
          "type": "string",
          "enum": ["stdio", "sse", "streamable-http"]
        },
        "host": {
          "default": "0.0.0.0",
          "type": "string"
        },
        "port": {
          "default": 8000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "allowedHosts": {
          "default": "",
          "type": "string"
        },
        "allowedOrigins": {
          "default": "",
          "type": "string"
        },
        "corsOrigins": {
          "default": "",
          "type": "string"
        },
        "sessionIdleTimeout": {
          "default": 86400000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "toolPageSize": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "toolSurface": {
          "default": "full",
          "type": "string",
          "enum": ["full", "core"]
        },
        "coreTools": {
          "default": "",
          "type": "string"
        },
        "appViews": {
          "default": false,
          "type": "boolean"
        },
        "capabilityGating": {
          "default": "annotate",
          "type": "string",
          "enum": ["off", "annotate", "filter"]
        }
      },
      "required": [
        "transport",
        "host",
        "port",
        "allowedHosts",
        "allowedOrigins",
        "corsOrigins",
        "sessionIdleTimeout",
        "toolPageSize",
        "toolSurface",
        "coreTools",
        "appViews",
        "capabilityGating"
      ],
      "additionalProperties": false
    },
