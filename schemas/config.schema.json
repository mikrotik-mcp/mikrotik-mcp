    "alerts": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "rules": {
          "default": [],
          "type": "array",
          "items": {}
        },
        "channels": {
          "default": {},
          "type": "object",
          "properties": {
            "slack": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
