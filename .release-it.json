{
  "$schema": "https://unpkg.com/release-it@20/schema/release-it.json",
  "git": {
    "commitMessage": "chore(): release v${version}",
    "commit": true,
    "tag": true,
    "push": true
  },
  "hooks": {
    "after:bump": ["bun --no-env-file scripts/sync-release-manifest.ts ${version}", "bun run gen"]
  },
  "github": {
    "release": true
  }
}
